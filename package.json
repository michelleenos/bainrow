{
	"name": "mish-bainrow",
	"description": "a collection of color palettes for generative art projects",
	"version": "1.0.28",
	"type": "module",
	"license": "ISC",
	"scripts": {
		"dev": "vite",
		"clean": "rm -rf dist",
		"build:lib": "tsc && vite build",
		"build:types": "tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist",
		"build": "run-s clean build:lib build:types",
		"build:site": "vite build --config vite.config.site.ts",
		"preview": "vite preview",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"preversion": "pnpm test && pnpm build && git add dist",
		"postversion": "pnpm publish",
		"postpublish": "git push && git push --tags",
		"release:patch": "pnpm version patch"
	},
	"devDependencies": {
		"@rollup/plugin-typescript": "^12.1.1",
		"@types/node": "^22.9.0",
		"@vitest/coverage-v8": "4.0.18",
		"@vitest/ui": "4.0.18",
		"npm-run-all2": "^7.0.1",
		"sass-embedded": "^1.80.6",
		"typescript": "~5.6.2",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"main": "./dist/bainrow.umd.cjs",
	"module": "./dist/bainrow.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/bainrow.js",
			"require": "./dist/bainrow.umd.cjs"
		}
	}
}
