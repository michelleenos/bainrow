{
	"name": "mish-bainrow",
	"description": "a collection of color palettes for generative art projects",
	"version": "1.0.22",
	"type": "module",
	"license": "ISC",
	"scripts": {
		"dev": "vite",
		"clean": "rm -rf dist",
		"build:lib": "tsc && vite build",
		"build:types": "tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist",
		"build": "run-s clean build:lib build:types",
		"preview": "vite preview",
		"test": "vitest --ui"
	},
	"devDependencies": {
		"@rollup/plugin-typescript": "^12.1.1",
		"@types/node": "^22.9.0",
		"@vitest/ui": "4.0.18",
		"npm-run-all2": "^7.0.1",
		"sass-embedded": "^1.80.6",
		"typescript": "~5.6.2",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/bainrow.js",
			"require": "./dist/bainrow.umd.cjs"
		}
	}
}
